{
  "name": "minimal",
  "author": {
    "name": "Sitefinity Front Еnd Team"
  },
  "version": "0.0.1",
  "devDependencies": {
    "autoprefixer": "10.4.13",
    "postcss": "8.5.31",
    "sass": "1.79.4"
  },
  "config": {
    "dist": "assets/dist",
    "src": "assets/src",
    "stylesDist": "assets/dist/css",
    "jsDist": "assets/dist/js",
    "stylesSrc": "assets/src/project/sass",
    "sitefinityStylesSrc": "assets/src/sitefinity/sass",
    "jsSrc": "assets/src/project/js",
    "sassFile": "main.scss",
    "cssFile": "main.css",
    "minCssFile": "main.min.css",
    "sitefinitySassFile": "sitefinity.scss",
    "sitefinityCssFile": "sitefinity.css",
    "sitefinityMinCssFile": "sitefinity.min.css",
    "editorSassFile": "editor.scss",
    "editorCssFile": "editor.min.css",
    "copyJs": ""
  },
  "scripts": {
    "sass:editor": "node scripts/styles.js editor && npm run postcss",
    "clean": "node scripts/clean.js",
    "copy:js": "node scripts/copy.js js",
    "copy": "node scripts/copy.js js",
    "postcss": "node scripts/postcss.js",
    "sass:sitefinity": "node scripts/styles.js sitefinity",
    "sass:build": "node scripts/styles.js build",
    "sass": "npm run sass:sitefinity && npm run sass:build && npm run postcss",
    "build": "npm run copy && npm run sass",
    "watch:styles": "node scripts/watch.js styles",
    "watch": "node scripts/watch.js styles",
    "start": "npm run build && npm run watch"
  }
}
